# Copy to .env and fill in real values. Never commit .env.

# PostgreSQL
DATABASE_URL=postgresql+psycopg://durgam:durgam@localhost:5432/durgam
DATABASE_URL_SYNC=postgresql+psycopg://durgam:durgam@localhost:5432/durgam

# Redis (Celery broker + Reflex pub-sub)
REDIS_URL=redis://localhost:6379/0

# MinIO object storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=durgam
MINIO_SECURE=false

# SMTP (Mailpit in dev)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@sssihl.edu.in

# Application
SECRET_KEY=change-me-before-production
DEBUG=true
ENVIRONMENT=development

# Test database (separate DB; used by pytest integration tests)
TEST_DATABASE_URL=postgresql+psycopg://durgam:durgam@localhost:5432/durgam_test
